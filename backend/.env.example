# Origin(s) of the deployed frontend, comma separated (CORS)
FRONTEND_ORIGIN=https://your-frontend.vercel.app
# Optional: allow Vercel preview URLs
# FRONTEND_ORIGIN_REGEX=https://.*\.vercel\.app
# Optional: enables AI simplification + translation in the Warning Decoder.
# Without it the decoder still works using the reviewed glossary.
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5
